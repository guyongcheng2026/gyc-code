{
  "name": "gyc-code",
  "version": "0.0.1",
  "description": "gyc-code: 自研 AI 编码 CLI（品牌自有、依赖零专有、协议自有基线）",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#fallback-solid": "./src/tui/fallback/solid/index.ts",
    "#fallback-solid/*": "./src/tui/fallback/solid/*"
  },
  "bin": {
    "gyc": "./bin/gyc"
  },
  "main": "./src/gyccode/index.ts",
  "scripts": {
    "postinstall": "node scripts/apply-opentui-patch.cjs || true; node scripts/apply-opentui-ffi-patch.cjs || true; node scripts/apply-opentui-orphan-patch.cjs || true; node scripts/apply-opentui-win32-resize-patch.cjs || true; node scripts/install-hooks.mjs; node scripts/verify-opentui-patches.cjs",
    "dev": "bun --preload ./scripts/bun-solid-preload.ts --conditions=browser ./src/gyccode/index.ts",
    "build": "bun build.mjs",
    "start": "bun dist/index.js",
    "test": "bun test --preload ./scripts/bun-solid-preload.ts --path-ignore-patterns=src/webapp",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:web": "npx vitest run --config src/webapp/vitest.config.ts src/webapp",
    "webapp:build": "node scripts/build-webapp.mjs",
    "prepack": "bun run webapp:build && bun run build",
    "prepublishOnly": "bun run build"
  },

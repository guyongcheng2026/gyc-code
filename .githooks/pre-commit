#!/bin/sh
# UTF-8 乱码防线：阻止 GBK 双重编码损坏的文件进入提交（P0-1 复发防护，2026-08-31）
# 检测逻辑见 scripts/check-mojibake.mjs；豁免 gen 产物。
# 兼容两种安装位置（.githooks/ 或 .git/hooks/）：一律以 git 仓库根解析脚本路径。
ROOT="$(git rev-parse --show-toplevel)"
node "$ROOT/scripts/check-mojibake.mjs" --staged || exit 1
# 高频缺陷模式防线（空 catch 吞错 / 空壳自递归），只查暂存的 TS 文件
STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)"
if [ -n "$STAGED" ]; then
  exec node "$ROOT/scripts/check-bug-patterns.mjs" $STAGED
fi
exit 0

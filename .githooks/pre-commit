#!/bin/sh
# 提交前四检统一入口（对标指标 18 · 代码审查）
#
# 这里只负责：定位仓库根 → 调用 .githooks/pre-commit-checks.mjs → 透传退出码。
# 具体检查逻辑（UTF-8 乱码防线 / 品牌合规守卫 / 工作区垃圾 / 高频缺陷模式 /
# 类型门禁 tsc --noEmit）全部收敛在那个模块里，理由有两个：
#   1. 模型可以在 git_commit 工具里用 run_checks=true 复用同一套检查，
#      不再出现「git hook 会拦、模型却毫不知情」的黑洞；
#   2. 检查逻辑可被单测直接调用，不必真的去 commit 一次来验证。
#
# 兼容两种安装位置（.githooks/ 或 .git/hooks/）：一律以 git 仓库根解析脚本路径。
ROOT="$(git rev-parse --show-toplevel)"
exec node "$ROOT/.githooks/pre-commit-checks.mjs"
#!/usr/bin/env node
// gyc — gyc-code CLI launcher
// Prefers the prebuilt dist bundle (fastest); falls back to TS source via Bun.
const { spawnSync } = require("child_process")
const path = require("path")
const fs = require("fs")

const distEntry = path.join(__dirname, "..", "dist", "index.js")
const srcEntry = path.join(__dirname, "..", "src", "gyccode", "index.ts")
const entry = fs.existsSync(distEntry) ? distEntry : srcEntry

const candidates = [
  process.env.GYC_BUN,
  "C:\\Program Files\\nodejs\\bun.exe",
  "C:\\Users\\谷勇成\\.bun\\bin\\bun.exe",
].filter(Boolean)
const bun = candidates.find((c) => {
  try {
    fs.accessSync(c)
    return true
  } catch {
    return false
  }
}) || "bun"

const preload = path.join(__dirname, "..", "scripts", "bun-solid-preload.ts")
const args = fs.existsSync(distEntry)
  ? ["--smol", entry, ...process.argv.slice(2)]
  : ["--smol", "run", "--preload", preload, "--conditions=browser", entry, ...process.argv.slice(2)]

const result = spawnSync(bun, args, { stdio: "inherit" })
if (result.error) {
  console.error("Failed to launch gyc:", result.error.message)
  process.exit(1)
}
process.exit(result.status ?? 0)
